{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HQ",
  "version": "0.4.1",
  "identifier": "dev.brydon.hq",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HQ",
        "width": 1400,
        "height": 900,
        "minWidth": 480,
        "minHeight": 360,
        "backgroundColor": "#181818",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFNzUzQUJFMzM0MDdFNzUKUldSMWZrQXp2anAxUHQveVVMSDRoNTJpdjNWS0VJMnBlL20zdWdVVU4rWG1RQUd2c1I1ejh2dC8K",
      "endpoints": ["https://github.com/BrydonJ/HQ-releases/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
